@startuml

top to bottom direction

skinparam componentStyle uml2
skinparam nodesep 60
skinparam ranksep 80

component "Frontend Web" as Frontend
component "API REST" as API

component "Módulo de Usuários" as Usuarios
component "Módulo de Eventos" as Eventos
component "Módulo de Inscrições" as Inscricoes
component "Módulo de Relatórios" as Relatorios

database "PostgreSQL" as DB

() "REST API" as REST

Frontend --> REST : HTTPS
REST -- API

() "Serviço Usuários" as IUsuarios
API -( IUsuarios : REST
IUsuarios -- Usuarios

() "Serviço Eventos" as IEventos
API -( IEventos : REST
IEventos -- Eventos

() "Serviço Inscrições" as IInscricoes
API -( IInscricoes : REST
IInscricoes -- Inscricoes

() "Serviço Relatórios" as IRelatorios
API -( IRelatorios : REST
IRelatorios -- Relatorios

() "Persistência SQL" as ISQL

Usuarios --> ISQL : JDBC
Eventos --> ISQL : JDBC
Inscricoes --> ISQL : JDBC
Relatorios --> ISQL : JDBC

ISQL -- DB

Usuarios -[hidden]down-> Eventos
Eventos -[hidden]down-> Inscricoes
Inscricoes -[hidden]down-> Relatorios

@enduml